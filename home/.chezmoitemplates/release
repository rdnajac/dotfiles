{{- $url := printf "https://github.com/%s/releases/download/%s/%s" .repo .tag .asset -}}
{{- if eq .tag "latest" }}
  {{- $url = printf "https://github.com/%s/releases/latest/download/%s" .repo .asset -}}
{{- end }}
.local/{{ .name }}:
  type: archive
  exact: true
  stripComponents: 1
  url: {{ $url | quote }}
  refreshPeriod: {{ .refreshPeriod }}
