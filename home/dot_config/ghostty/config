theme = TokyoNight Night
# background = #000000
background = #16161d
# background-blur = false
# background-blur = macos-glass-regular
background-blur = macos-glass-clear
background-opacity = 0.8
background-opacity-cells = false
# more visually appealing with window transparency
macos-window-shadow = false

shell-integration-features = ssh-env,ssh-terminfo

# double-click selects a whitespace-delimited WORD (vim-style);
# keep │ as a boundary so split borders don't get selected.
selection-word-chars = " \t│,`"
# `true` only copies to the selection pasteboard on macOS;
# `clipboard` also copies to the system clipboard so cmd+v works
copy-on-select = clipboard
# cursor-click-to-move = true   # click moves shell cursor
# focus-follows-mouse = true    # hover focuses split
# mouse-shift-capture = never   # shift+click always extends selection

# hacky way to override settings; only works on an empty prompt
keybind = super+,=text:chezmoi edit --watch ~/.config/ghostty/config\n
# keybind = chain=reload_config

keybind = super+b=toggle_background_opacity
# keybind = global:cmd+backquote=toggle_quick_terminal


# https://ghostty.org/docs/config/reference#custom-shader
# https://catskull.net/fun-with-ghostty-shaders.html>
cursor-style = block
custom-shader = ~/.config/ghostty/shaders/cursor_blaze_tapered.glsl
# custom-shader-animation = always

config-file = font
config-file = ?macos
