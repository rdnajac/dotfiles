#!/bin/sh
set -eu

HOMEBREW_NO_ENV_HINTS=1 brew update && brew upgrade -y
brew cleanup -s > /dev/null 2>&1 &
{
  brew bundle dump --force --file=- \
    | awk '/^#/{comment=$0; next} {print $0 "\t" comment; comment=""}' \
    | sort \
    > "{{ .chezmoi.cacheDir }}/Brewfile" 2>/dev/null && echo "Brewfile updated"
} &
